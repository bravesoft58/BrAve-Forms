# BrAve Forms - Local Development Environment
# Copy to .env and fill in values: cp env.example .env
# .env is gitignored -- never commit actual secrets

# PostgreSQL
POSTGRES_PASSWORD=brave_secure_pass

# Valkey (Redis-compatible)
REDIS_PASSWORD=redis_secure_pass

# Clerk Authentication (get from https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_your_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# S3-compatible Storage (SeaweedFS locally, DigitalOcean Spaces in prod)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_REGION=us-east-1
S3_ENDPOINT=http://seaweedfs:8333
S3_BUCKET_NAME=brave-forms-uploads
