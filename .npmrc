# pnpm Configuration for BrAve Forms
# Fix Windows symlink issues with Next.js builds

# Use hoisted node_modules structure (no symlinks)
# This prevents Next.js from deleting files in symlinked folders during builds
# See: https://github.com/opennextjs/opennextjs-cloudflare/issues/80
node-linker=hoisted

# Strict peer dependencies (recommended for monorepo)
strict-peer-dependencies=false

# Auto-install peers (convenience)
auto-install-peers=true
