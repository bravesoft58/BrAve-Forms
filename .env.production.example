# BrAve Forms - Production Environment Variables
# Copy this file to .env.production and fill in your values
#
# IMPORTANT: Never commit .env.production to git!

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
# Generate password: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://brave:CHANGE_ME_STRONG_PASSWORD@postgres:5432/brave_forms?schema=public

# ===========================================
# REDIS (BullMQ Queue)
# ===========================================
# Generate password: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_PASSWORD@redis:6379

# ===========================================
# CLERK AUTHENTICATION
# ===========================================
# Get from Clerk Dashboard > API Keys (use PRODUCTION keys)
CLERK_SECRET_KEY=sk_live_YOUR_SECRET_KEY
CLERK_PUBLISHABLE_KEY=pk_live_YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_PUBLISHABLE_KEY

# ===========================================
# DIGITALOCEAN SPACES (S3-Compatible Storage)
# ===========================================
# Create Spaces bucket and API key in DigitalOcean console
# Endpoint format: https://{region}.digitaloceanspaces.com
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_BUCKET_NAME=braveforms-photos
AWS_ACCESS_KEY_ID=YOUR_SPACES_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SPACES_SECRET_KEY
AWS_REGION=nyc3

# ===========================================
# APPLICATION URLS
# ===========================================
# Replace with your actual domain or droplet IP
NEXT_PUBLIC_GRAPHQL_ENDPOINT=https://api.braveforms.yourdomain.com/graphql
CORS_ORIGIN=https://braveforms.yourdomain.com

# For testing without domain (use droplet IP):
# NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://YOUR_DROPLET_IP:4000/graphql
# CORS_ORIGIN=http://YOUR_DROPLET_IP:3000

# ===========================================
# SECURITY
# ===========================================
# Generate: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_STRING

# ===========================================
# OPTIONAL: Weather API (for EPA compliance features)
# ===========================================
# NOAA_API_KEY=your_noaa_api_key
# OPENWEATHERMAP_API_KEY=your_openweathermap_key
